{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@screens/*": ["screens/*"],
      "@utils/*": ["utils/*"],
      "@assets/*": ["assets/*"],
      "@hooks/*": ["hooks/*"],
      "@api/*":["api/*"],
      "@features/*":["features/*"],
      "@localize/*" :["localize/*"],
      "@navigation/*": ["navigation/*"],
      "@redux/*": ["redux/*"]
    }
  }
}
